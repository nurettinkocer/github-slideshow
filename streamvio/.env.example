# StreamVio Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=streamvio

# JWT Configuration
JWT_SECRET=streamvio_super_secret_jwt_key_2024_change_this_in_production
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=streamvio_session_secret_change_this_in_production

# Admin Default Credentials
ADMIN_EMAIL=admin@streamvio.com
ADMIN_PASSWORD=Admin123!

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./public/assets/uploads

# Site Configuration
SITE_URL=http://localhost:3000
SITE_NAME=StreamVio
